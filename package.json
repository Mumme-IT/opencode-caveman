{
  "name": "@mumme-it/opencode-caveman",
  "version": "1.0.2",
  "description": "OpenCode V2 plugin — per-request caveman rules and database-wide mode switching",
  "keywords": ["opencode", "plugin", "caveman", "token", "compression"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mumme-IT/opencode-caveman.git"
  },
  "type": "module",
  "packageManager": "bun@1.3.11",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build index.ts --outdir dist --target node --external @opencode/plugin",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build && bun test tests packaging",
    "test": "bun test tests",
    "test:package": "bun run build && bun test packaging",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.21"
  },
  "devDependencies": {
    "@opencode/sdk": "2.0.21",
    "@types/bun": "1.3.11",
    "typescript": "5.8.3"
  }
}
